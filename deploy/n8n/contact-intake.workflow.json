{
  "name": "gthanasis.com contact intake",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "gthanasis-contact",
        "responseMode": "responseNode",
        "options": { "allowedOrigins": "https://gthanasis.com" }
      },
      "id": "5f1a8a52-0c1b-4c0e-9a51-0f6b2f7a9c01",
      "name": "Contact form",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [0, 0],
      "webhookId": "gthanasis-contact"
    },
    {
      "parameters": {
        "jsCode": "// Validate and normalise one submission. Bots that fill the hidden\n// `website` field are accepted silently and dropped, so they learn nothing.\nconst body = $input.first().json.body ?? {};\nconst headers = $input.first().json.headers ?? {};\nconst str = (v, max) => (typeof v === 'string' ? v.trim().slice(0, max) : '');\n\nconst idea = str(body.idea, 5000);\nconst email = str(body.email, 320).toLowerCase();\nconst name = str(body.name, 200);\nconst spam = str(body.website, 200) !== '';\nconst valid = idea.length >= 8 && /^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/.test(email);\n\nreturn [{ json: {\n  keep: valid && !spam,\n  valid,\n  row: {\n    received_at: new Date().toISOString(),\n    email,\n    name,\n    idea,\n    source: str(body.source, 100) || 'gthanasis.com',\n    country: str(headers['cf-ipcountry'], 8),\n    status: 'new',\n  },\n} }];"
      },
      "id": "8c2d4b73-1d2c-4f1f-8b62-1a7c3e8b0d02",
      "name": "Validate",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "id": "c1", "leftValue": "={{ $json.valid }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "9d3e5c84-2e3d-4a2a-9c73-2b8d4f9c1e03",
      "name": "Valid?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [480, 0]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "typeValidation": "strict" },
          "conditions": [
            { "id": "c2", "leftValue": "={{ $json.keep }}", "rightValue": true, "operator": { "type": "boolean", "operation": "true", "singleValue": true } }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "ae4f6d95-3f4e-4b3b-8d84-3c9e5a0d2f04",
      "name": "Not spam?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [720, -100]
    },
    {
      "parameters": {
        "dataTableId": { "__rl": true, "mode": "id", "value": "uXIdrY6j1V0AfL2M" },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "received_at": "={{ $json.row.received_at }}",
            "email": "={{ $json.row.email }}",
            "name": "={{ $json.row.name }}",
            "idea": "={{ $json.row.idea }}",
            "source": "={{ $json.row.source }}",
            "country": "={{ $json.row.country }}",
            "status": "={{ $json.row.status }}"
          }
        },
        "options": {}
      },
      "id": "bf507ea6-405f-4c4c-9e95-4dae6b1e3a05",
      "name": "Save to contact_requests",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1,
      "position": [960, -200]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: true } }}", "options": { "responseCode": 200 } },
      "id": "c0618fb7-5160-4d5d-8fa6-5ebf7c2f4b06",
      "name": "OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [1200, -100]
    },
    {
      "parameters": { "respondWith": "json", "responseBody": "={{ { ok: false, error: 'invalid' } }}", "options": { "responseCode": 400 } },
      "id": "d172a0c8-6271-4e6e-9ab7-6fd8ad3a5c07",
      "name": "Bad request",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [720, 120]
    }
  ],
  "connections": {
    "Contact form": { "main": [[{ "node": "Validate", "type": "main", "index": 0 }]] },
    "Validate": { "main": [[{ "node": "Valid?", "type": "main", "index": 0 }]] },
    "Valid?": { "main": [[{ "node": "Not spam?", "type": "main", "index": 0 }], [{ "node": "Bad request", "type": "main", "index": 0 }]] },
    "Not spam?": { "main": [[{ "node": "Save to contact_requests", "type": "main", "index": 0 }], [{ "node": "OK", "type": "main", "index": 0 }]] },
    "Save to contact_requests": { "main": [[{ "node": "OK", "type": "main", "index": 0 }]] }
  },
